{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for FlowDeck",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-set-view-bounds",
    "allow-open-view",
    "allow-hide-view",
    "allow-set-view-covered",
    "allow-reload-view",
    "allow-back-view",
    "allow-forward-view",
    "allow-set-view-zoom",
    "allow-unload-view",
    "allow-remove-view",
    "allow-load-accounts",
    "allow-save-accounts",
    "allow-list-prompts",
    "allow-create-prompt",
    "allow-update-prompt",
    "allow-delete-prompt",
    "allow-toggle-prompt-pinned"
  ]
}
